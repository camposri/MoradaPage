{
  "name": "morada-premium",
  "version": "1.0.0",
  "description": "Sistema completo de imobiliária com frontend e backend",
  "main": "api/index.js",
  "scripts": {
    "start": "node api/index.js",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && npm install && npm run dev",
    "frontend": "python -m http.server 8000",
    "build": "node build.js",
    "build:vercel": "node build-vercel.js",
    "deploy": "npm run build && echo 'Ready for deployment'",
    "serve": "npm run frontend",
    "install-backend": "cd backend && npm install",
    "vercel-build": "npm run build:vercel && echo 'Build completed successfully'"
  },
  "keywords": [
    "real-estate",
    "imobiliaria",
    "frontend",
    "backend",
    "fullstack"
  ],
  "author": "Valmike Junior",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}